# Base URL of the train-db backend's REST API, including the /api/v1
# prefix (see the backend's OpenApiConfig for why routes are versioned).
# Must be a NEXT_PUBLIC_ var since it's read from both server and client
# components (see services/api.ts) - Next.js inlines these at build time.
#
# Local dev (default if unset):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Production example (set this in Vercel's project environment variables,
# not in a committed .env file):
# NEXT_PUBLIC_API_BASE_URL=https://train-db.onrender.com/api/v1

# This site's own public URL - used for metadataBase (canonical/OG URLs),
# app/robots.ts and app/sitemap.ts. Falls back to localhost:3000 for local
# dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://raillens.vercel.app
