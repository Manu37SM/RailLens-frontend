NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (no NEXT_PUBLIC_ prefix): shared with the backend's
# RAILLENS_CLIENT_IP_PROXY_SECRET so sign-in rate limits stay per visitor.
RAILLENS_PROXY_SECRET=

# Single login (Phase 4D). Who handles sign-in: raillens (default, RailLens accounts) or railops (the RailOps
# login shared with the RailOps app). Read at build time: change it, then redeploy. Rollback = set raillens again.
NEXT_PUBLIC_RAILLENS_LOGIN_PROVIDER=raillens
# Only used when the line above is railops. Server-only.
# RailOps gateway address, e.g. https://railops-gateway.onrender.com
RAILOPS_API_URL=
# Same value as the RailOps gateway's RAILOPS_EDGE_PROXY_SECRET (at least 32 characters), so RailOps' login rate
# limits count each visitor separately instead of the whole website as one.
RAILOPS_PROXY_SECRET=
